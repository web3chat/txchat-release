# 复制为同目录 key 后按需修改（key 勿提交仓库）:
#   cp script/compose/key.example script/compose/key
#
# make init-compose 会读取本文件：
#   - 密码 → envfill 写入 run_compose/.env
#   - 联邦变量 → 写入 .env，并注入各模块 toml（含 Presence URL）
#
# 仅支持 KEY=value（不要写 export）；命令行 make VAR=... 优先级更高。
# 请使用 LF 换行（Unix）；若从 Windows 编辑出现 CRLF，envfill 会自动去除 \r。

# ---------- 密码（可选；不填则 init-compose 自动随机生成）----------
MYSQL_ROOT_PASSWORD=
MINIO_ROOT_PASSWORD=

# ---------- 联邦 / Presence（可选）----------
# 单集群保持 false；要联邦时再改成 true
FEDERATION_ENABLED=false
# CLUSTER_ID 不写时，联邦 init-compose 生成 cluster-<节点号>-<8位随机串>
# 例如 cluster-360-a1b2c3d4。Presence 还没有该集群时会停并给出登记命令。
# 登记后重跑同一条命令会复用这个 ID。要固定名字再写：
# CLUSTER_ID=
# 中心 Presence HTTP。只有 FEDERATION_ENABLED=true 时才会写入运行配置；false 时忽略本行
# PRESENCE_URL=http://txchat-presence:18050
# Snowflake Node。联邦模式不写这一行时，make init-compose 会向 Presence
# 在 128～1023 里随机占一个空闲号，校验通过才继续。
# 写了就固定用这个号（0～1023）；被占用或与已登记值不一致时初始化失败。
# GENERATOR_NODE=
